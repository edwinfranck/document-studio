{
  "name": "@studio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Document Studio, application de bureau : le serveur local et l'interface dans une fenêtre, PDF par le Chromium d'Electron.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare-runtime": "node scripts/prepare.mjs",
    "dist": "node scripts/prepare.mjs && electron-builder --linux AppImage",
    "dist:win": "node scripts/prepare.mjs && electron-builder --win nsis",
    "dist:mac": "node scripts/prepare.mjs && electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "author": "Edwin Franck",
  "license": "MIT",
  "build": {
    "appId": "dev.devpanl.documentstudio",
    "productName": "Document Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "studio",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "icon.png",
      "executableName": "document-studio"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "icon.png"
    },
    "executableName": "document-studio"
  }
}
