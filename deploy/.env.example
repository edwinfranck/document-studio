# Copier en .env à la racine du dépôt, puis : docker compose up -d
# Nom de domaine qui pointe vers le serveur (enregistrement DNS A ou AAAA)
STUDIO_DOMAIN=studio.exemple.org
# invite : seules les adresses invitées créent un compte ; open : inscription libre
STUDIO_SIGNUP=invite
# Adresses e-mail administratrices (installation des plugins), séparées par des virgules ; le premier compte l'est toujours
STUDIO_ADMINS=
# Envoi des e-mails (invitations, notifications) ; vide = notifications dans l'application seulement
STUDIO_SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.org:465
STUDIO_MAIL_FROM=Document Studio <studio@exemple.org>
